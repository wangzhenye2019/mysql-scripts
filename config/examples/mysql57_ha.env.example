# 文件权限必须是 0600；复制为 /etc/mysql-scripts/mysql57-ha.env 后填写真实值。
# 此示例只适用于 Debian 12 + MySQL 5.7.44 遗留高可用集群。

MYSQL57_VERSION="5.7.44"
MYSQL57_BASE_DIR="/opt/mysql57"
MYSQL57_DATA_DIR="/srv/mysql57/data"
MYSQL57_LOG_DIR="/var/log/mysql57"
MYSQL57_PORT="3306"
MYSQL57_SOCKET="/run/mysqld/mysql57.sock"
MYSQL57_SERVER_ID="101"

# 集群拓扑。PRIMARY_HOST 为当前写主，CANDIDATE_HOST 为优先提升副本。
PRIMARY_HOST="db57-primary.example.internal"
CANDIDATE_HOST="db57-replica-a.example.internal"
REPLICA_HOSTS_CSV="db57-replica-a.example.internal,db57-replica-b.example.internal"

# MySQL 凭据。请替换占位符，禁止提交真实密码。
MYSQL_ADMIN_USER="ha_admin"
MYSQL_ADMIN_PASSWORD="REPLACE_WITH_STRONG_SECRET"
MYSQL_REPLICATION_USER="repl"
MYSQL_REPLICATION_PASSWORD="REPLACE_WITH_STRONG_SECRET"

# 增强半同步。RPO=0 的实现要求 AFTER_SYNC，且不允许监测到异步回退后继续写入。
SEMI_SYNC_WAIT_COUNT="1"
SEMI_SYNC_TIMEOUT_MS="60000"
SEMI_SYNC_WAIT_POINT="AFTER_SYNC"

# Orchestrator 配置。Orchestrator 仅在服务发现/fencing hook 成功后才可继续自动恢复。
ORCHESTRATOR_API_URL="http://orc-1.example.internal:3000"
ORCHESTRATOR_USER="orchestrator"
ORCHESTRATOR_PASSWORD="REPLACE_WITH_STRONG_SECRET"
ORCHESTRATOR_TOPOLOGY_USER="orchestrator"
ORCHESTRATOR_TOPOLOGY_PASSWORD="REPLACE_WITH_STRONG_SECRET"

# 由 Orchestrator post-failover hook 调用的唯一 VIP 流程；禁止与独立 Keepalived 状态机并行争抢写 VIP。
WRITE_VIP="192.0.2.50"
VIP_CIDR="24"
VIP_INTERFACE="ens18"
VIP_FENCING_COMMAND="/usr/local/lib/mysql57-ha/fence-old-primary.sh"

# 当健康门禁发现半同步回退时，执行阻断写入的本机命令。生产建议接入代理/网关写入口，而非只设 read_only。
WRITE_FENCE_COMMAND="/usr/local/lib/mysql57-ha/fence-writes.sh"

# 只读巡检监控。设为 primary 或 replica 时增加角色一致性校验；auto 仅检查本机可观察状态。
MYSQL57_MONITOR_EXPECTED_ROLE="auto"
MYSQL57_MONITOR_INTERVAL_SEC="30"

# 自动化演练：生产环境必须填写变更单号，并显式确认影响。故障注入命令由基础设施团队提供，
# 例如受审计的 VM/PDU/安全组隔离脚本；本仓库不提供 kill 或断网的默认实现。
ORCHESTRATOR_CLUSTER_ALIAS="mysql57-prod"
MYSQL57_DRILL_TIMEOUT_SEC="120"
DRILL_FAULT_INJECTION_COMMAND="/usr/local/lib/mysql57-ha/inject-approved-fault.sh"
