# 文件权限必须是 0600；复制为 /etc/mysql-scripts/mysql84-ic.env 后填写真实值。
# 此示例只适用于 Debian 12 + 官方 MySQL 8.4 Server/Shell/Router。

MYSQL84_VERSION="8.4"
MYSQL84_PORT="3306"
MYSQL84_X_PORT="33060"
MYSQL84_GR_PORT="33061"
MYSQL84_CLUSTER_NAME="prodCluster"
MYSQL84_COMMUNICATION_STACK="MYSQL"
MYSQL84_SINGLE_PRIMARY="true"
MYSQL84_RECOVERY_METHOD="clone"

# 以逗号分隔的实例管理端点；第一个节点用于创建集群。
MYSQL84_SEED_INSTANCE="ic-1.example.internal:3306"
MYSQL84_INSTANCES_CSV="ic-1.example.internal:3306,ic-2.example.internal:3306,ic-3.example.internal:3306"
MYSQL84_SERVER_IDS_CSV="801,802,803"

# AdminAPI TCP 管理账户。实际生产环境应使用 TLS，并限制来源地址。
MYSQL84_ADMIN_USER="ic_admin"
MYSQL84_ADMIN_PASSWORD="REPLACE_WITH_STRONG_SECRET"
MYSQL84_ROOT_USER="root"
MYSQL84_ROOT_PASSWORD="REPLACE_WITH_STRONG_SECRET"

# Router 部署。推荐让每个应用节点本地运行 Router；以下变量适用于执行 bootstrap 的节点。
MYSQL84_ROUTER_BOOTSTRAP_INSTANCE="ic-1.example.internal:3306"
MYSQL84_ROUTER_USER="router"
MYSQL84_ROUTER_BOOTSTRAP_DIRECTORY="/etc/mysqlrouter/prodCluster"
MYSQL84_ROUTER_SERVICE_NAME="mysqlrouter-prodCluster"
MYSQL84_ROUTER_RW_PORT="6446"
MYSQL84_ROUTER_RO_PORT="6447"

# TLS 文件按本机实际路径配置；若强制 TLS，所有实例需具备一致、可验证的 CA 策略。
MYSQL84_REQUIRE_SECURE_TRANSPORT="ON"
MYSQL84_CA_FILE="/etc/mysql/certs/ca.pem"
MYSQL84_CERT_FILE="/etc/mysql/certs/server-cert.pem"
MYSQL84_KEY_FILE="/etc/mysql/certs/server-key.pem"
